# ==============================================================================
# SPEC'26 Event Application - Environment Configuration
# Department of Electronic Engineering, NED University
# ==============================================================================

# Server Environment
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Supabase Project Credentials (Optional - app falls back seamlessly to LocalStorage)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Database Connection Strings (Optional - for Prisma CLI schema migrations)
# Direct connection to PostgreSQL database (e.g. Supabase port 5432)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# Transaction pooled connection (e.g. Supabase PgBouncer port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Google Gemini API Key (Optional - for intelligent event assistants / features)
GEMINI_API_KEY=""

# Application Host URL (for OAuth redirect callbacks)
APP_URL="http://localhost:3000"
